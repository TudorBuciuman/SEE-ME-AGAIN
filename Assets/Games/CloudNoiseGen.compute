// CloudNoiseGen.compute
// Bakes a 3D texture packing:
//   R = Perlin-Worley "shape" noise (low frequency, defines the big billowing forms)
//   G/B/A = Worley FBM "detail" noise at increasing frequency (used to erode edges)
// Sampled by VolumetricClouds.shader at runtime.

#pragma kernel CSMain

RWTexture3D<float4> Result;
int Resolution;
float Seed;

float3 hash33(float3 p)
{
    p = float3(
        dot(p, float3(127.1, 311.7, 74.7)),
        dot(p, float3(269.5, 183.3, 246.1)),
        dot(p, float3(113.5, 271.9, 124.6)));
    return -1.0 + 2.0 * frac(sin(p) * 43758.5453123 + Seed);
}

// Tileable Worley noise: distance to nearest of 27 neighboring feature points,
// with cell indices wrapped by freq so the result tiles seamlessly.
float Worley(float3 p, float freq)
{
    p *= freq;
    float3 id = floor(p);
    float3 fd = frac(p);
    float minDist = 1.0;

    for (int x = -1; x <= 1; x++)
    for (int y = -1; y <= 1; y++)
    for (int z = -1; z <= 1; z++)
    {
        float3 offset = float3(x, y, z);
        float3 cell = fmod(id + offset + freq * 100.0, freq); // keep positive, then wrap
        float3 h = hash33(cell) * 0.5 + 0.5;
        float3 r = offset + h - fd;
        minDist = min(minDist, dot(r, r));
    }
    return 1.0 - saturate(sqrt(minDist));
}

float WorleyFbm(float3 p, float freq)
{
    return Worley(p, freq) * 0.625 +
           Worley(p, freq * 2.0) * 0.25 +
           Worley(p, freq * 4.0) * 0.125;
}

// Tileable gradient (Perlin-style) noise
float Perlin(float3 p, float freq)
{
    p *= freq;
    float3 i = floor(p);
    float3 f = frac(p);
    float3 u = f * f * (3.0 - 2.0 * f);

    float n000 = dot(hash33(fmod(i + float3(0,0,0) + freq*100.0, freq)), f - float3(0,0,0));
    float n100 = dot(hash33(fmod(i + float3(1,0,0) + freq*100.0, freq)), f - float3(1,0,0));
    float n010 = dot(hash33(fmod(i + float3(0,1,0) + freq*100.0, freq)), f - float3(0,1,0));
    float n110 = dot(hash33(fmod(i + float3(1,1,0) + freq*100.0, freq)), f - float3(1,1,0));
    float n001 = dot(hash33(fmod(i + float3(0,0,1) + freq*100.0, freq)), f - float3(0,0,1));
    float n101 = dot(hash33(fmod(i + float3(1,0,1) + freq*100.0, freq)), f - float3(1,0,1));
    float n011 = dot(hash33(fmod(i + float3(0,1,1) + freq*100.0, freq)), f - float3(0,1,1));
    float n111 = dot(hash33(fmod(i + float3(1,1,1) + freq*100.0, freq)), f - float3(1,1,1));

    float nx00 = lerp(n000, n100, u.x);
    float nx10 = lerp(n010, n110, u.x);
    float nx01 = lerp(n001, n101, u.x);
    float nx11 = lerp(n011, n111, u.x);
    float nxy0 = lerp(nx00, nx10, u.y);
    float nxy1 = lerp(nx01, nx11, u.y);
    return lerp(nxy0, nxy1, u.z) * 0.5 + 0.5;
}

float remap(float v, float lo, float hi, float outLo, float outHi)
{
    return outLo + (v - lo) / max(hi - lo, 1e-5) * (outHi - outLo);
}

[numthreads(4,4,4)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    float3 uvw = (float3(id) + 0.5) / Resolution;

    // Low-frequency Perlin FBM = big-scale cloud "puff" shape
    float perlinFbm =
        Perlin(uvw, 4.0)  * 0.5   +
        Perlin(uvw, 8.0)  * 0.25  +
        Perlin(uvw, 16.0) * 0.125 +
        Perlin(uvw, 32.0) * 0.0625;

    // Worley FBM carves billowy cauliflower structure into the Perlin base
    float worleyBase = WorleyFbm(uvw, 4.0);
    float perlinWorley = saturate(remap(perlinFbm, worleyBase * 0.6, 1.0, 0.0, 1.0));

    float worleyDetail1 = WorleyFbm(uvw, 8.0);
    float worleyDetail2 = WorleyFbm(uvw, 16.0);
    float worleyDetail3 = WorleyFbm(uvw, 32.0);

    Result[id] = float4(perlinWorley, worleyDetail1, worleyDetail2, worleyDetail3);
}
