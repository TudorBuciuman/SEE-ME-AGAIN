--- !u!114 &1693312789
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1693312787}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 118e894f5a50a084c913d75367678a05, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueBox: {fileID: 1060042601}
  speakerText: {fileID: 0}
  bodyText: {fileID: 1447044607}
  blipSource: {fileID: 0}
  defaultBlip: {fileID: 0}
  defaultCharsPerSecond: 30
  blipEveryNChars: 5
  holdAfterTyped: 1.2
  lines:
  - text: "The Devil is playing chess \nwith a man for his soul."
    charsPerSecond: 11
    holdAfterTyped: 0
    blipSound: {fileID: 0}
  - text: "The man covers his face, \nconvinced he has lost."
    charsPerSecond: 11
    holdAfterTyped: 0
    blipSound: {fileID: 0}
  - text: "The Devil watches silently, \ncertain of victory."
    charsPerSecond: 11
    holdAfterTyped: 0
    blipSound: {fileID: 0}
  - text: "The board shows checkmate. \nNo escape in sight."
    charsPerSecond: 11
    holdAfterTyped: 0
    blipSound: {fileID: 0}
  - text: "An angel stands in the background, \nwithout intervening."
    charsPerSecond: 11
    holdAfterTyped: 0
    blipSound: {fileID: 0}
  - text: But the game isn't over.
    charsPerSecond: 11
    holdAfterTyped: 0
    blipSound: {fileID: 0}
  - text: The young man still has a chance.
    charsPerSecond: 11
    holdAfterTyped: 0
    blipSound: {fileID: 0}
  - text: One move remains.
    charsPerSecond: 11
    holdAfterTyped: 0
    blipSound: {fileID: 0}
  - text: This is not the Devil's victory.
    charsPerSecond: 11
    holdAfterTyped: 0
    blipSound: {fileID: 0}
  - text: Not yet.
    charsPerSecond: 11
    holdAfterTyped: 0
    blipSound: {fileID: 0}
  playOnStart: 1
  waitOnStart: 3
